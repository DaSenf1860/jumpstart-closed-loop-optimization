      },
      "text": "fn_LiveKpis()\n| project MachineId, DefectPct = round(CurrentDefectRate*100,1)\n| order by MachineId asc",
      "id": "eafde787-6b40-4bcb-94da-c3142bebeb3c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "a6591953-5965-42d1-9053-ae56df8a37ec"
      },
      "text": "fn_LiveKpis()\n| project MachineId, LineId, Mode, Status, DefectPct=round(CurrentDefectRate*100,1), TempSetpoint, PressureSetpoint\n| order by MachineId asc",
      "id": "e9e42af4-c702-4e34-9dd9-55fdec865e02",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "a6591953-5965-42d1-9053-ae56df8a37ec"
      },
      "text": "OptimizationEvents\n| where Timestamp > ago(120m)\n| summarize Decisions=count() by bin(Timestamp, 5m), Action\n| order by Timestamp asc",
